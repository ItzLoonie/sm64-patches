+/**
+ * Prints a Level Items screen entry's label at the given unlocked/active
+ * state: full white when true (or nonzero, for numeric entries), dim gray
+ * when false (or zero). This is the single place that decides that color,
+ * so every entry on the screen - boolean or numeric - goes through it.
+ */
+static void render_pause_unlock_text(s16 x, s16 y, const u8 *str, bool active) {
+    if (active) {
+        gDPSetEnvColor(gDisplayListHead++, 255, 255, 255, gDialogTextAlpha);
+    } else {
+        gDPSetEnvColor(gDisplayListHead++, 128, 128, 128, gDialogTextAlpha);
+    }
+    print_generic_string(x, y, str);
+    gDPSetEnvColor(gDisplayListHead++, 255, 255, 255, gDialogTextAlpha);
+}
 
