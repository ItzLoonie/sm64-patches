+// '-' and '$' aren't covered by the ASCII_TO_DIALOG macro, so they're written directly
+// using their charmap.txt values. SM64AP_DIALOG_CHAR_DOLLAR renders as the game's coin
+// icon glyph, not a literal dollar sign.
+#define DIALOG_CHAR_DASH          0x9F
+#define SM64AP_DIALOG_CHAR_DOLLAR 0xF9
+
+// Every course/secret page's max star count for display purposes. Main courses show all
+// 7 slots (6 course stars + 100 coins); the Castle page shows the 5 castle secret stars
+// (2 MIPS + 3 Toads); Princess's Secret Slide has 2 stars; every other secret/cap level
+// has exactly 1.
+static s16 pause_unlock_view_max_stars(const struct PauseUnlockView *view) {
+    if (view->type == PAUSE_UNLOCK_VIEW_CASTLE) {
+        return 5;
+    }
+    if (view->courseNum < COURSE_STAGES_COUNT) {
+        return 7;
+    }
+    if (view->courseNum == COURSE_PSS - 1) {
+        return 2;
+    }
+    return 1;
+}
+
+// The actual CourseNum to use for Permanent Coin Collection lookups. Every non-castle
+// view's courseNum field is course-index-minus-one (see sPauseUnlockViews), while the
+// Castle view's courseNum field is already the literal COURSE_NONE.
+static s16 pause_unlock_view_coin_course(const struct PauseUnlockView *view) {
+    if (view->type == PAUSE_UNLOCK_VIEW_CASTLE) {
+        return COURSE_NONE;
+    }
+    return view->courseNum + COURSE_MIN;
+}
+
+// Appends " - <star icons>, $<coins>[/<peak>]" to baseTitle into dest, showing this save's
+// star progress for the page and its Permanent Coin Collection total. Some outputs spend
+// permanent coins, so the current total can drop after it peaks; when that's happened we
+// show it as current/peak instead of silently reporting the lower number.
+static void pause_append_stage_stats(const u8 *baseTitle, u8 *dest, s16 maxLength,
+                                      const struct PauseUnlockView *view) {
+    s16 i = 0;
+    s16 d;
+    s16 maxStars = pause_unlock_view_max_stars(view);
+    s16 coinCourse = pause_unlock_view_coin_course(view);
+    u32 starFlags = (view->type == PAUSE_UNLOCK_VIEW_CASTLE)
+        ? save_file_get_star_flags(gCurrSaveFileNum - 1, -1)
+        : save_file_get_star_flags(gCurrSaveFileNum - 1, view->courseNum);
+    s32 coinTotal = SM64AP_GetPermanentCoinTotal(coinCourse);
+    s32 coinPeak = SM64AP_GetPermanentCoinPeak(coinCourse);
+    u8 digits[4];
+
+    while (baseTitle[i] != DIALOG_CHAR_TERMINATOR && i < maxLength - 1) {
+        dest[i] = baseTitle[i];
+        i++;
+    }
+
+    if (i < maxLength - 1) dest[i++] = DIALOG_CHAR_SPACE;
+    if (i < maxLength - 1) dest[i++] = DIALOG_CHAR_DASH;
+    if (i < maxLength - 1) dest[i++] = DIALOG_CHAR_SPACE;
+
+    for (d = 0; d < maxStars && i < maxLength - 1; d++) {
+        dest[i++] = (starFlags & (1U << d)) ? DIALOG_CHAR_STAR_FILLED : DIALOG_CHAR_STAR_OPEN;
+    }
+
+    // Skip the coin readout entirely if there's nothing to report (e.g. Castle,
+    // where Permanent Coin Collection data isn't tracked) rather than showing "$0".
+    if (coinTotal != 0 || coinPeak != 0) {
+        if (i < maxLength - 1) dest[i++] = DIALOG_CHAR_SPACE;
+        if (i < maxLength - 1) dest[i++] = SM64AP_DIALOG_CHAR_DOLLAR;
+
+        int_to_str(coinTotal, digits);
+        for (d = 0; digits[d] != DIALOG_CHAR_TERMINATOR && i < maxLength - 1; d++) {
+            dest[i++] = digits[d];
+        }
+
+        if (coinPeak > coinTotal) {
+            if (i < maxLength - 1) dest[i++] = DIALOG_CHAR_SLASH;
+            int_to_str(coinPeak, digits);
+            for (d = 0; digits[d] != DIALOG_CHAR_TERMINATOR && i < maxLength - 1; d++) {
+                dest[i++] = digits[d];
+            }
+        }
+    }
+
+    dest[i] = DIALOG_CHAR_TERMINATOR;
+}
+
 static const u8 *pause_unlock_view_title(const struct PauseUnlockView *view) {
     void **courseNameTbl = get_pause_course_name_table();
+    static u8 sPauseUnlockViewStatsTitle[64];
+    const u8 *baseTitle;
 
     if (view->type == PAUSE_UNLOCK_VIEW_COURSE) {
-        return segmented_to_virtual(courseNameTbl[view->courseNum]);
+        baseTitle = segmented_to_virtual(courseNameTbl[view->courseNum]);
+    } else {
+        baseTitle = view->label;
     }
 
-    return view->label;
+    pause_append_stage_stats(baseTitle, sPauseUnlockViewStatsTitle, sizeof(sPauseUnlockViewStatsTitle), view);
+    return sPauseUnlockViewStatsTitle;
 }
 
