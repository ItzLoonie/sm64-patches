@@ -6978,6 +6983,35 @@ int SM64AP_CollectedPermanentRedCoins(int course) {
     return collected;
 }
 
+// Current Permanent Coin Collection total for a course (sum of every coin still
+// held for that course). This can go down over time, since some outputs spend
+// permanent coins, which is why SM64AP_GetPermanentCoinPeak exists below.
+int SM64AP_GetPermanentCoinTotal(int course) {
+    int total = 0;
+
+    for (const auto &entry : sm64_permanent_coins) {
+        if (entry.second.course == course) {
+            total += entry.second.value;
+        }
+    }
+    return total;
+}
+
+// Highest Permanent Coin Collection total ever observed for a course this session.
+// Calling this also feeds the current total into the high-water mark, so the Level
+// Items screen can show "current/peak" if a coin was spent since the peak.
+int SM64AP_GetPermanentCoinPeak(int course) {
+    int total = SM64AP_GetPermanentCoinTotal(course);
+
+    if (course < 0 || course > COURSE_MAX) {
+        return total;
+    }
+    if (total > sm64_permanent_coin_peak[course]) {
+        sm64_permanent_coin_peak[course] = (s16) total;
+    }
+    return sm64_permanent_coin_peak[course];
+}
